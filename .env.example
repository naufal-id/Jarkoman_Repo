# Password untuk masuk ke /admin. WAJIB diset di Netlify: Site configuration > Environment variables.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Opsional: kunci rahasia untuk token login dan kunci "Batal ikut" pemain. Kalau kosong, token login
# memakai turunan ADMIN_PASSWORD dan kunci pemain memakai rahasia acak yang disimpan di store.
# JARKOMAN_SECRET=
